      "types": "./vite-pwa-base.d.ts",
      "default": "./vite-pwa-base.js"
    },
    "./vite-csp": {
      "types": "./vite-csp.d.ts",
      "default": "./vite-csp.js"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./tailwind-preset.css": "./tailwind-preset.css",
    "./components.css": "./components.css"
