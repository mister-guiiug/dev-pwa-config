      "types": "./vitest-browser-base.d.ts",
      "default": "./vitest-browser-base.js"
    },
    "./playwright-base": {
      "types": "./playwright-base.d.ts",
      "default": "./playwright-base.js"
    },
    "./playwright-a11y": {
      "types": "./playwright-a11y.d.ts",
      "default": "./playwright-a11y.js"
