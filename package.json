    "@rive-app/react-canvas": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@vitest/browser": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lucide-react": "^1.0.0",
    "playwright": "^1.49.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "sharp": ">=0.33.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
