    "./vitest-setup": {
      "types": "./vitest-setup.d.ts",
      "default": "./vitest-setup.js"
    },
    "./apps-catalog": {
      "types": "./apps-catalog.d.ts",
      "default": "./apps-catalog.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
