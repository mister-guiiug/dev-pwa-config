{
  "name": "@mister-guiiug/dev-wpa-config",
  "version": "3.5.2",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "showroom": "node scripts/serve-showroom.mjs",
    "showroom:sync": "node --eval \"require('node:fs').copyFileSync('components.css','showroom/components.css')\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "description": "Configurations partagées (ESLint, Prettier, TypeScript, Vitest, Playwright, Tailwind, commitlint, lint-staged) + reusable workflows + composite actions pour les projets miss-* et mister-*.",
  "license": "MIT",
  "author": "GuiiuG",
  "homepage": "https://github.com/mister-guiiug/dev-wpa-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mister-guiiug/dev-wpa-config.git"
  },
  "bugs": {
    "url": "https://github.com/mister-guiiug/dev-wpa-config/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    "./eslint-base": "./eslint-base.js",
    "./eslint-react": "./eslint-react.js",
