{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "*.js",
    "*.d.ts",
    "react/**/*.js",
    "react/**/*.d.ts",
    "types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "showroom",
    "templates",
    "prettier.config.js",
    "eslint.config.js"
  ]
}
